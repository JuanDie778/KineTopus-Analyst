<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>KineTopus-Analyst · Portal de Servicio Multi-Lente (v{{ version }})</title>
  <style>
    :root, [data-theme="dark"] {
      --bg: #070d19;
      --surface: #101828;
      --surface-alt: #182338;
      --border: #263552;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --cyan: #22d3ee;
      --amber: #f59e0b;
      --violet: #c084fc;
      --bull: #10b981;
      --bear: #f43f5e;
    }
    [data-theme="light"] {
      --bg: #f1f5f9;
      --surface: #ffffff;
      --surface-alt: #f8fafc;
      --border: #cbd5e1;
      --text: #0f172a;
      --muted: #475569;
      --cyan: #0891b2;
      --amber: #d97706;
      --violet: #9333ea;
      --bull: #059669;
      --bear: #e11d48;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.45;
      padding: 20px;
    }
    .container { max-width: 1240px; margin: 0 auto; }
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      padding-bottom: 16px;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }
    .brand { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .brand h1 { font-size: 1.35rem; font-weight: 800; letter-spacing: 0.01em; }
    .badge {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface-alt);
      color: var(--amber);
    }
    .top-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .btn {
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      font-size: 0.80rem;
      font-weight: 600;
      padding: 7px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface-alt);
      color: var(--text);
      transition: border-color 0.15s ease;
    }
    .btn:hover { border-color: var(--amber); }
    .btn-primary {
      background: var(--amber);
      border-color: var(--amber);
      color: #090d16;
      font-weight: 700;
    }
    .launcher {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 22px;
      display: flex;
      gap: 10px;
      align-items: flex-end;
      flex-wrap: wrap;
    }
    .field { display: flex; flex-direction: column; gap: 4px; }
    .field label { font-size: 0.73rem; font-weight: 700; color: var(--muted); }
    .field input, .field select {
      background: var(--surface-alt);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 7px 11px;
      font-size: 0.85rem;
    }
    #statusMsg { font-size: 0.80rem; color: var(--cyan); margin-left: 6px; }
    .section-title {
      font-size: 1.0rem;
      font-weight: 700;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .alerts-strip {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 16px;
      margin-bottom: 22px;
    }
    .alert-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding: 6px 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.80rem;
    }
    .alert-row:last-child { border-bottom: none; }
    .sev-CRITICAL { color: var(--bear); font-weight: 800; }
    .sev-WARNING { color: var(--amber); font-weight: 700; }
    .sev-INFO { color: var(--cyan); font-weight: 700; }
    .assets-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(520px, 1fr));
      gap: 18px;
    }
    .asset-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .asset-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }
    .asset-links { display: flex; gap: 6px; flex-wrap: wrap; }
    iframe.widget-frame {
      width: 100%;
      height: 430px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: transparent;
    }
    .empty-state {
      background: var(--surface);
      border: 1px dashed var(--border);
      border-radius: 12px;
      padding: 28px;
      text-align: center;
      color: var(--muted);
    }
    @media (max-width: 640px) {
      .assets-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header class="topbar">
      <div class="brand">
        <h1>KineTopus-Analyst · Hub B2B &amp; Indicador Portable</h1>
        <span class="badge">Servicio v{{ version }}</span>
        <span class="badge">{{ tickers|length }} activo{{ 's' if tickers|length != 1 else '' }} en caché</span>
      </div>
      <div class="top-actions">
        <a class="btn" href="/api/v1/health" target="_blank" rel="noopener">Salud API</a>
        <a class="btn" href="/api/v1/tickers" target="_blank" rel="noopener">Catálogo JSON</a>
        <a class="btn" href="/api/v1/alerts" target="_blank" rel="noopener">Feed Alertas</a>
        <button type="button" class="btn" id="portalThemeBtn">◐ Tema</button>
      </div>
    </header>

    <form class="launcher" id="analyzeForm">
      <div class="field">
        <label for="tickerInput">Símbolo (Yahoo Finance)</label>
        <input id="tickerInput" name="ticker" type="text" value="BTC-USD" placeholder="Ej. BTC-USD, SPY, AAPL" required>
      </div>
      <div class="field">
        <label for="intervalSelect">Intervalo</label>
        <select id="intervalSelect" name="interval">
          <option value="1d" selected>1d (Diario)</option>
          <option value="1wk">1wk (Semanal)</option>
          <option value="1h">1h (Horario)</option>
        </select>
      </div>
      <div class="field">
        <label for="refreshCheck">Modo Caché</label>
        <select id="refreshCheck" name="refresh">
          <option value="false" selected>Usar caché si existe</option>
          <option value="true">Recalcular motor (refresh)</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary" id="submitBtn">Analizar / Cargar Activo</button>
      <span id="statusMsg"></span>
    </form>

    {% if active_alerts %}
    <section class="alerts-strip">
      <div class="section-title">
        <span>Alertas Físico-Geométricas Activas ({{ active_alerts|length }})</span>
      </div>
      {% for al in active_alerts[:8] %}
      <div class="alert-row">
        <div>
          <span class="sev-{{ al.severity }}">[{{ al.severity }}]</span>
          <strong>{{ al.ticker }}</strong> · {{ al.title }}
        </div>
        <span style="color:var(--muted)">{{ al.last_date }}</span>
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <div class="section-title">
      <span>Widgets Multi-Lente Embebibles (`&lt; 35 KB` SVG) y Entregables B2B</span>
    </div>

    {% if tickers %}
    <div class="assets-grid">
      {% for item in tickers %}
      <article class="asset-card">
        <div class="asset-bar">
          <div>
            <strong>{{ item.ticker }}</strong>
            <span style="color:var(--muted); font-size:0.80rem;">· {{ item.last_date }} · {{ item.human_banner }}</span>
          </div>
          <div class="asset-links">
            {% if item.has_full_report %}
            <a class="btn" href="{{ item.urls.report_html }}" target="_blank" rel="noopener">Reporte Completo</a>
            {% endif %}
            <a class="btn" href="{{ item.urls.widget_html }}" target="_blank" rel="noopener">Widget iframe</a>
            <a class="btn" href="{{ item.urls.indicator_json }}" target="_blank" rel="noopener">Feed JSON</a>
            <a class="btn" href="{{ item.urls.pine_script }}" target="_blank" rel="noopener">Pine v5</a>
          </div>
        </div>
        <iframe class="widget-frame" src="{{ item.urls.widget_html }}" loading="lazy" title="Widget {{ item.ticker }}"></iframe>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">
      No hay activos en caché todavía en <code>{{ reports_root }}</code>. Usa el formulario superior para analizar tu primer ticker.
    </div>
    {% endif %}
  </div>

  <script>
    (function () {
      var root = document.documentElement;
      var tBtn = document.getElementById("portalThemeBtn");
      if (tBtn) {
        tBtn.addEventListener("click", function () {
          var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
          root.setAttribute("data-theme", next);
          var frames = document.querySelectorAll("iframe.widget-frame");
          frames.forEach(function (fr) {
            var base = fr.getAttribute("src").split("?")[0];
            fr.setAttribute("src", base + "?theme=" + next);
          });
        });
      }

      var form = document.getElementById("analyzeForm");
      var statusEl = document.getElementById("statusMsg");
      var btnEl = document.getElementById("submitBtn");
      if (form) {
        form.addEventListener("submit", function (ev) {
          ev.preventDefault();
          var ticker = document.getElementById("tickerInput").value.trim();
          var interval = document.getElementById("intervalSelect").value;
          var refresh = document.getElementById("refreshCheck").value === "true";
          if (!ticker) return;
          btnEl.disabled = true;
          statusEl.textContent = "Ejecutando motor Multi-Lente para " + ticker + "...";
          fetch("/api/v1/analyze", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ticker: ticker, interval: interval, refresh: refresh })
          })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
              btnEl.disabled = false;
              if (!res.ok) {
                statusEl.textContent = "Error: " + (res.data.detail || "Fallo en análisis");
                return;
              }
              statusEl.textContent = "Listo (" + res.data.ticker + "). Recargando catálogo...";
              window.location.reload();
            })
            .catch(function (err) {
              btnEl.disabled = false;
              statusEl.textContent = "Error de red: " + err;
            });
        });
      }
    })();
  </script>
</body>
</html>
