<!DOCTYPE html>
<html lang="es" data-theme="{{ default_theme }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>KineTopus Widget · {{ asset.ticker }} ({{ asset.interval }})</title>
  <style>
    :root, [data-theme="dark"] {
      --bg: #0b1120;
      --card: #111827;
      --card-alt: #172033;
      --border: #24324b;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --price-line: #e2e8f0;
      --grid: rgba(148, 163, 184, 0.14);
      --today: rgba(250, 204, 21, 0.72);
      --cyan: #22d3ee;
      --amber: #f59e0b;
      --violet: #c084fc;
      --bull: #10b981;
      --bear: #f43f5e;
      --cone-iqr: rgba(245, 158, 11, 0.22);
      --cone-outer: rgba(245, 158, 11, 0.08);
      --pill-bg: rgba(30, 41, 59, 0.85);
    }
    [data-theme="light"] {
      --bg: #f8fafc;
      --card: #ffffff;
      --card-alt: #f1f5f9;
      --border: #cbd5e1;
      --text: #0f172a;
      --muted: #475569;
      --price-line: #1e293b;
      --grid: rgba(71, 85, 105, 0.14);
      --today: rgba(202, 138, 4, 0.78);
      --cyan: #0891b2;
      --amber: #d97706;
      --violet: #9333ea;
      --bull: #059669;
      --bear: #e11d48;
      --cone-iqr: rgba(217, 119, 6, 0.18);
      --cone-outer: rgba(217, 119, 6, 0.07);
      --pill-bg: rgba(241, 245, 249, 0.92);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      padding: 10px;
      line-height: 1.35;
    }
    .widget-shell {
      max-width: 820px;
      margin: 0 auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
    }
    .hdr {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }
    .title-group { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
    .ticker { font-size: 1.15rem; font-weight: 800; letter-spacing: 0.02em; }
    .price { font-size: 1.08rem; font-weight: 700; color: var(--amber); }
    .submeta { font-size: 0.75rem; color: var(--muted); }
    .banner {
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text);
      margin-top: 2px;
    }
    .badges { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .pill {
      font-size: 0.70rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--pill-bg);
      color: var(--text);
      white-space: nowrap;
    }
    .pill-conf-ALTA { border-color: var(--bull); color: var(--bull); }
    .pill-conf-MEDIA { border-color: var(--amber); color: var(--amber); }
    .pill-conf-BAJA { border-color: var(--bear); color: var(--bear); }
    .pill-alert { border-color: var(--bear); color: var(--bear); }
    .theme-btn {
      cursor: pointer;
      font-size: 0.70rem;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--card-alt);
      color: var(--muted);
    }
    .theme-btn:hover { color: var(--text); }
    .legend {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      font-size: 0.71rem;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .leg-item { display: inline-flex; align-items: center; gap: 5px; }
    .dot { width: 9px; height: 3px; border-radius: 2px; display: inline-block; }
    .chart-box {
      width: 100%;
      background: var(--card-alt);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 4px;
      margin-bottom: 10px;
    }
    svg.hero-svg { width: 100%; height: auto; display: block; overflow: visible; }
    .svg-grid { stroke: var(--grid); stroke-width: 1; }
    .svg-today { stroke: var(--today); stroke-width: 1.2; stroke-dasharray: 4 3; }
    .svg-price { fill: none; stroke: var(--price-line); stroke-width: 1.55; stroke-linejoin: round; }
    .svg-c2000 { fill: none; stroke: var(--cyan); stroke-width: 1.7; }
    .svg-c1000 { fill: none; stroke: var(--amber); stroke-width: 2.3; }
    .svg-c500 { fill: none; stroke: var(--violet); stroke-width: 1.6; }
    .svg-p2000 { fill: none; stroke: var(--cyan); stroke-width: 1.6; stroke-dasharray: 4 3; }
    .svg-p1000 { fill: none; stroke: var(--amber); stroke-width: 2.2; stroke-dasharray: 5 3; }
    .svg-p500 { fill: none; stroke: var(--violet); stroke-width: 1.5; stroke-dasharray: 3 3; }
    .svg-cone-outer { fill: var(--cone-outer); stroke: none; }
    .svg-cone-iqr { fill: var(--cone-iqr); stroke: none; }
    .svg-lbl { font-size: 9.5px; fill: var(--muted); font-family: inherit; }
    .svg-tag { font-size: 9.5px; font-weight: 700; font-family: inherit; }
    .lenses-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: 8px;
    }
    .lens-card {
      background: var(--card-alt);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 7px 9px;
      border-top-width: 3px;
    }
    .lens-2000 { border-top-color: var(--cyan); }
    .lens-1000 { border-top-color: var(--amber); }
    .lens-500 { border-top-color: var(--violet); }
    .lens-hdr {
      display: flex;
      justify-content: space-between;
      font-size: 0.70rem;
      font-weight: 700;
      color: var(--muted);
      margin-bottom: 2px;
    }
    .lens-state {
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .lens-metrics {
      display: flex;
      justify-content: space-between;
      font-size: 0.70rem;
      color: var(--muted);
    }
    .pos { color: var(--bull); font-weight: 700; }
    .neg { color: var(--bear); font-weight: 700; }
    .scenarios-bar {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      padding-top: 7px;
      border-top: 1px solid var(--border);
      font-size: 0.71rem;
    }
    .sc-item { display: flex; flex-direction: column; gap: 1px; }
    .sc-lbl { color: var(--muted); font-weight: 600; }
    .sc-val { font-weight: 700; color: var(--text); }
    .ftr {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 6px;
      font-size: 0.66rem;
      color: var(--muted);
    }
    @media (max-width: 600px) {
      .lenses-grid, .scenarios-bar { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="widget-shell">
    <div class="hdr">
      <div>
        <div class="title-group">
          <span class="ticker">{{ asset.ticker }}</span>
          <span class="price">{{ fmt.last_close }}</span>
          <span class="submeta">{{ asset.interval }} · {{ asset.last_date }}</span>
        </div>
        <div class="banner">{{ verdict.human_banner }}</div>
      </div>
      <div class="badges">
        <span class="pill pill-conf-{{ verdict.global_physical_confidence }}">Confianza {{ verdict.global_physical_confidence }}</span>
        {% if alerts_count > 0 %}
        <span class="pill pill-alert">{{ alerts_count }} alerta{{ 's' if alerts_count != 1 else '' }}</span>
        {% endif %}
        <button type="button" class="theme-btn" id="ktThemeBtn" title="Cambiar tema">◐ Tema</button>
      </div>
    </div>

    <div class="legend">
      <span class="leg-item"><span class="dot" style="background:var(--price-line)"></span>Cierre ({{ svg.tail_candles }}v)</span>
      <span class="leg-item"><span class="dot" style="background:var(--cyan)"></span>2000v Cian</span>
      <span class="leg-item"><span class="dot" style="background:var(--amber)"></span>1000v Ámbar + P25–P75</span>
      <span class="leg-item"><span class="dot" style="background:var(--violet)"></span>500v Violeta</span>
    </div>

    <div class="chart-box">
      <svg class="hero-svg" viewBox="0 0 {{ svg.width }} {{ svg.height }}" role="img" aria-label="Gráfico multi-lente KineTopus {{ asset.ticker }}">
        {% for g in svg.y_ticks %}
        <line class="svg-grid" x1="{{ svg.pad_l }}" y1="{{ g.y }}" x2="{{ svg.x_end }}" y2="{{ g.y }}"></line>
        <text class="svg-lbl" x="{{ svg.pad_l + 2 }}" y="{{ g.y - 3 }}">{{ g.label }}</text>
        {% endfor %}

        {% if svg.cone_outer_points %}
        <polygon class="svg-cone-outer" points="{{ svg.cone_outer_points }}"></polygon>
        {% endif %}
        {% if svg.cone_iqr_points %}
        <polygon class="svg-cone-iqr" points="{{ svg.cone_iqr_points }}"></polygon>
        {% endif %}

        <line class="svg-today" x1="{{ svg.x_today }}" y1="{{ svg.pad_t }}" x2="{{ svg.x_today }}" y2="{{ svg.y_bottom }}"></line>
        <text class="svg-lbl" x="{{ svg.x_today }}" y="{{ svg.y_bottom + 13 }}" text-anchor="middle">Hoy ({{ asset.last_date[5:] }})</text>
        <text class="svg-lbl" x="{{ svg.pad_l }}" y="{{ svg.y_bottom + 13 }}" text-anchor="start">{{ svg.first_tail_date }}</text>
        <text class="svg-lbl" x="{{ svg.x_end }}" y="{{ svg.y_bottom + 13 }}" text-anchor="end">t+{{ svg.horizon_steps }}</text>

        {% if svg.price_points %}
        <polyline class="svg-price" points="{{ svg.price_points }}"></polyline>
        {% endif %}
        {% if svg.curve_2000_path %}
        <path class="svg-c2000" d="{{ svg.curve_2000_path }}"></path>
        {% endif %}
        {% if svg.curve_500_path %}
        <path class="svg-c500" d="{{ svg.curve_500_path }}"></path>
        {% endif %}
        {% if svg.curve_1000_path %}
        <path class="svg-c1000" d="{{ svg.curve_1000_path }}"></path>
        {% endif %}

        {% if svg.proj_2000_points %}
        <polyline class="svg-p2000" points="{{ svg.proj_2000_points }}"></polyline>
        {% endif %}
        {% if svg.proj_500_points %}
        <polyline class="svg-p500" points="{{ svg.proj_500_points }}"></polyline>
        {% endif %}
        {% if svg.proj_1000_points %}
        <polyline class="svg-p1000" points="{{ svg.proj_1000_points }}"></polyline>
        {% endif %}

        {% for tag in svg.right_tags %}
        <text class="svg-tag" x="{{ svg.x_end + 5 }}" y="{{ tag.y }}" fill="{{ tag.color }}">{{ tag.text }}</text>
        {% endfor %}
      </svg>
    </div>

    <div class="lenses-grid">
      {% for l in lenses_cards %}
      <div class="lens-card lens-{{ l.win_class }}">
        <div class="lens-hdr">
          <span>{{ l.window_candles }}v · {{ l.color_name }}</span>
          <span>R² {{ l.r2_fmt }}</span>
        </div>
        <div class="lens-state" title="{{ l.full_label }}">{{ l.state_label }}</div>
        <div class="lens-metrics">
          <span>Brecha {{ l.gap_fmt }}</span>
          <span class="{{ 'pos' if l.t150_ret >= 0 else 'neg' }}">t+{{ svg.horizon_steps }} {{ l.t150_ret_fmt }}</span>
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="scenarios-bar">
      <div class="sc-item">
        <span class="sc-lbl">Soporte P25 (Bajista)</span>
        <span class="sc-val neg">{{ fmt.bear_target }} ({{ fmt.bear_ret }}) · P={{ fmt.bear_prob }}</span>
      </div>
      <div class="sc-item">
        <span class="sc-lbl">Centro 1000v (t+{{ svg.horizon_steps }})</span>
        <span class="sc-val">{{ fmt.base_target }} ({{ fmt.base_ret }}) · IQR {{ fmt.iqr_prob }}</span>
      </div>
      <div class="sc-item">
        <span class="sc-lbl">Expansión P75 (Alcista)</span>
        <span class="sc-val pos">{{ fmt.bull_target }} ({{ fmt.bull_ret }}) · P={{ fmt.bull_prob }}</span>
      </div>
    </div>

    <div class="ftr">
      <span>KineTopus Multi-Lens · Geometría Pura</span>
      <span>Esquema {{ schema_version }}</span>
    </div>
  </div>

  <script>
    (function () {
      var root = document.documentElement;
      var params = new URLSearchParams(window.location.search);
      var qTheme = params.get("theme");
      if (qTheme === "light" || qTheme === "dark") {
        root.setAttribute("data-theme", qTheme);
      }
      var btn = document.getElementById("ktThemeBtn");
      if (btn) {
        btn.addEventListener("click", function () {
          var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
          root.setAttribute("data-theme", next);
        });
      }
    })();
  </script>
</body>
</html>
